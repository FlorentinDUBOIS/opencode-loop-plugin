{
  "name": "@prevalentware/opencode-loop-plugin",
  "version": "0.1.0",
  "description": "OpenCode loop plugin that adds Claude Code-style /loop recurring prompts: a persistent scheduler that re-injects an instruction into a session on an interval while it is idle.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode loop plugin",
    "opencode recurring tasks",
    "opencode scheduler",
    "loop",
    "recurring",
    "slash-command",
    "coding-agent",
    "ai-agent",
    "developer-tools",
    "agent",
    "tui"
  ],
  "homepage": "https://github.com/prevalentWare/opencode-loop-plugin#readme",
  "bugs": {
    "url": "https://github.com/prevalentWare/opencode-loop-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prevalentWare/opencode-loop-plugin.git"
  },
  "license": "MIT",
  "author": "Prevalentware",
  "type": "module",
  "exports": {
    "./server": {
      "import": "./dist/server.js"
    },
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && bun build ./src/server.ts --outdir ./dist --target bun && bun scripts/build-tui.ts",
    "ci:version": "bun scripts/resolve-ci-version.ts",
    "lint": "eslint .",
    "pack:dry-run": "npm pack --dry-run",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run test && bun run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.19.5",
    "@opentui/solid": "^0.7.0",
    "effect": "^4.0.7",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opencode/client": "^2.2.0",
    "@opencode/plugin": "^2.2.0",
    "@opencode/schema": "^2.2.0",
    "@opencode/theme": "^2.2.0",
    "@opentui/core": "^0.7.0",
    "@types/bun": "^1.4.4",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "opencode": ">=1.17.1 <2 || >=2.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "toml": "^5.0.1",
    "zod": "^4.6.7"
  }
}
